{
  "name": "visual-studio-2015-mcp",
  "version": "0.5.0",
  "private": true,
  "description": "Local MCP tools for Visual Studio 2015 using PowerShell 7",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test test/*.test.mjs",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.mjs",
    "test:cancellation": "node test/cancellation.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0"
  }
}
